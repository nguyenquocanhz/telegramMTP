# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# From https://my.telegram.org/apps
API_ID=
API_HASH=

# From @BotFather
BOT_TOKEN=

# Telegram user IDs allowed to run admin commands (/stats, /say).
# Several IDs: ADMIN_ID=111111111,222222222
# Don't know yours? Start the bot with any number here, send it /id,
# then put the real ID in and restart.
ADMIN_ID=

# Optional
LOG_LEVEL=info
# SESSION_FILE=data/session.json
# SECRET_MASTER_KEY=        # passphrase for secrets.enc (natterbot secret set KEY)
